# syntax=docker/dockerfile:1

FROM openmodelica/openmodelica:v1.26.3-ompython@sha256:7346a515478822dae99d53c0acce93462a087773c8497be720748f1cff4d5161

ARG MODELICA_STANDARD_LIBRARY_URL="https://github.com/modelica/ModelicaStandardLibrary/releases/download/v4.1.0/ModelicaStandardLibrary_v4.1.0.zip"
ARG MODELICA_STANDARD_LIBRARY_SHA256=5409cfa17797c52d866dc9d2675badc1378b4bbf88066e60899a489cb1cb8a2d
ARG BUILDINGS_LIBRARY_URL="https://github.com/lbl-srg/modelica-buildings/releases/download/v14.0.0/Buildings-v14.0.0.zip"
ARG BUILDINGS_LIBRARY_SHA256=e088afbb9582df183d978bd94615e209c714123130b84c20dd7d3593a6da31ad

LABEL org.opencontainers.image.title="OpenModelica with Modelica Buildings" \
      org.opencontainers.image.description="OpenModelica 1.26.3, OMPython, Modelica Standard Library 4.1.0 and Buildings 14.0.0" \
      org.opencontainers.image.source="https://github.com/krolbot/building-simulation-images" \
      org.opencontainers.image.licenses="OSMC-PL-1.8 AND BSD-3-Clause"

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates curl unzip \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /opt/modelica-libraries \
 && curl -L --fail --silent --show-error -o /tmp/msl.zip "${MODELICA_STANDARD_LIBRARY_URL}" \
 && echo "${MODELICA_STANDARD_LIBRARY_SHA256}  /tmp/msl.zip" | sha256sum -c - \
 && unzip -q /tmp/msl.zip -d /opt/modelica-libraries \
 && curl -L --fail --silent --show-error -o /tmp/buildings.zip "${BUILDINGS_LIBRARY_URL}" \
 && echo "${BUILDINGS_LIBRARY_SHA256}  /tmp/buildings.zip" | sha256sum -c - \
 && unzip -q /tmp/buildings.zip -d /opt/modelica-libraries \
 && rm -f /tmp/msl.zip /tmp/buildings.zip

ENV OPENMODELICALIBRARY="/opt/modelica-libraries"

RUN printf '%s\n' \
      'loadModel(Modelica, {"4.1.0"});' \
      'loadModel(Buildings, {"14.0.0"});' \
      'getVersion(Buildings);' \
      'getErrorString();' > /tmp/verify-libraries.mos \
 && omc /tmp/verify-libraries.mos | tee /tmp/verify-libraries.out \
 && grep -q '"14.0.0"' /tmp/verify-libraries.out \
 && rm -f /tmp/verify-libraries.mos /tmp/verify-libraries.out

WORKDIR /workspace
CMD ["sleep", "infinity"]
