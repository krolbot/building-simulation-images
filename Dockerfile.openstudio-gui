# syntax=docker/dockerfile:1

FROM ubuntu:24.04@sha256:f610ab94648195aa356059f5b41d6085c9d4d903c072430cdd1af7bdb646106b

ARG OPENSTUDIO_APP_VERSION=1.12.0-rc2
ARG OPENSTUDIO_APP_BUILD=2c9f7455ef
ARG OPENSTUDIO_ARCHIVE="OpenStudioApplication-${OPENSTUDIO_APP_VERSION}+${OPENSTUDIO_APP_BUILD}-Ubuntu24.04.tar.gz"
ARG OPENSTUDIO_URL="https://github.com/openstudiocoalition/OpenStudioApplication/releases/download/v${OPENSTUDIO_APP_VERSION}/OpenStudioApplication-${OPENSTUDIO_APP_VERSION}%2B${OPENSTUDIO_APP_BUILD}-Ubuntu24.04.tar.gz"
ARG OPENSTUDIO_SHA256=d8cc05adc87ffb56eb168a7810efcb4cbd37d974d2a35f9606ed903da0586710

LABEL org.opencontainers.image.title="OpenStudio Application browser desktop" \
      org.opencontainers.image.description="Monolithic OpenStudio Application 1.12.0-rc2 browser desktop with bundled OpenStudio SDK 3.11.0 and EnergyPlus 25.2.0" \
      org.opencontainers.image.source="https://github.com/krolbot/building-simulation-images" \
      org.opencontainers.image.licenses="BSD-3-Clause-like"

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl dbus-x11 fluxbox libasound2t64 libdbus-1-3 libegl1 libfontconfig1 \
      libgl1 libglu1-mesa libnss3 libx11-6 libx11-xcb1 libxcomposite1 libxcursor1 \
      libxdamage1 libxext6 libxfixes3 libxi6 libxkbcommon-x11-0 libxrandr2 libxrender1 \
      libxtst6 libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 \
      libxcb-render-util0 libxcb-shape0 libxcb-util1 libxcb-xkb1 novnc tini websockify \
      x11-utils x11vnc xvfb \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /opt/openstudio-app /config /workspace \
 && curl -L --fail --silent --show-error -o "/tmp/${OPENSTUDIO_ARCHIVE}" "${OPENSTUDIO_URL}" \
 && echo "${OPENSTUDIO_SHA256}  /tmp/${OPENSTUDIO_ARCHIVE}" | sha256sum -c - \
 && tar -xzf "/tmp/${OPENSTUDIO_ARCHIVE}" -C /opt/openstudio-app --strip-components=4 \
 && rm -f "/tmp/${OPENSTUDIO_ARCHIVE}" \
 && test -x /opt/openstudio-app/bin/OpenStudioApp \
 && test "$(/opt/openstudio-app/bin/openstudio --version)" = "3.11.0+241b8abb4d" \
 && /opt/openstudio-app/EnergyPlus/energyplus --version | grep -q '25.2.0' \
 && chown -R 1000:1000 /config /workspace

COPY gui/openstudio/start-gui.sh /usr/local/bin/start-gui
COPY gui/common/index.html /usr/share/novnc/index.html

ENV DISPLAY=:1 \
    HOME=/config \
    QT_X11_NO_MITSHM=1 \
    QTWEBENGINE_DISABLE_SANDBOX=0 \
    LIBGL_ALWAYS_SOFTWARE=1 \
    DISPLAY_WIDTH=1920 \
    DISPLAY_HEIGHT=1080 \
    PATH="/opt/openstudio-app/bin:${PATH}"

USER 1000:1000
WORKDIR /workspace
EXPOSE 5800
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/start-gui"]
